POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LLM_API_KEY=your_llm_api_key_here
LLM_USE_LOCAL=false
LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:11434/v1 # Uncomment this line if using local Ollama
LLM_MODEL=google/gemini-2.5-flash 
# LLM_MODEL=qwen2.5:0.5b # Uncomment this line to use Qwen 2.5 instead of Gemini

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=knowledge_base

# Infinity Embedding/Reranking Server
INFINITY_BASE_URL=http://localhost:7997
INFINITY_EMBEDDING_MODEL=BAAI/bge-m3
INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Unstructured API (PDF Parser)
UNSTRUCTURED_BASE_URL=http://localhost:8001
