POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LLM_API_KEY=your_llm_api_key_here
LLM_USE_LOCAL=false
LLM_BASE_URL=https://openrouter.ai/api/v1
