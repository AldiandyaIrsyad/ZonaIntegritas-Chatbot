# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LLM Configuration
LLM_OLLAMA_PORT=11434
LLM_API_KEY=your_llm_api_key_here
LLM_USE_LOCAL=false
LLM_LOCAL_BASE_URL=http://127.0.0.1:${LLM_OLLAMA_PORT}/v1
LLM_LOCAL_MODEL=qwen2.5:0.5b
LLM_PUBLIC_BASE_URL=https://openrouter.ai/api/v1
LLM_PUBLIC_MODEL=google/gemini-2.5-flash 

# HUGGING FACE
HF_SECRET=your_hf_secret

# Qdrant Vector Database
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=knowledge_base

# Unstructured API (PDF Parser)
UNSTRUCTURED_BASE_URL=http://127.0.0.1:8001

# Infinity Embedding/Reranking Server
INFINITY_BASE_URL=http://127.0.0.1:7997
INFINITY_EMBEDDING_MODEL=BAAI/bge-m3
INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INFINITY_PROMPT_GUARD_MODEL=meta-llama/Prompt-Guard-86M
INFINITY_NLI_MODEL=StevenLimcorn/indo-roberta-indonli

# RAM
RAM_NLI_MODEL=${INFINITY_NLI_MODEL} 

# Input Validation Module (IVM)
IVM_SECURITY_THRESHOLD=0.75
IVM_SIMILARITY_THRESHOLD=0.3

# OBSERVABILITY
# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password

# Vector database for Observability
VECTOR_HOST=127.0.0.1
VECTOR_PORT=9000

