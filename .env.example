# =============================================================================
# .env.example — Domain-Agnostic RAG LLM Chatbot (Skripsi)
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables use pydantic-settings with env_prefix per domain module.
# Variables marked [REQUIRED] must be set before running the application.
# Variables marked [OPTIONAL] have sensible defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Application (prefix: APP_)
#   Source: app/shared/config.py → AppSettings
# -----------------------------------------------------------------------------
APP_TITLE="Chat Application with PDF Knowledge Base"
APP_VERSION="1.0.0"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=true


# -----------------------------------------------------------------------------
# PostgreSQL Database (prefix: POSTGRES_)
#   Source: app/shared/config.py → DatabaseSettings
#   Used by: docker-compose.yaml (postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme                    # [REQUIRED] Set a strong password
POSTGRES_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Structured Logging / Observability (prefix: LOGGER_)
#   Source: app/shared/config.py → LoggerSettings
#   Used by: docker-compose.yaml (loki, vector, grafana services)
# -----------------------------------------------------------------------------
LOGGER_VECTOR_PORT=9000
LOGGER_LOKI_PORT=3100
LOGGER_GRAFANA_PORT=3000
LOGGER_USERNAME=admin
LOGGER_PASSWORD=changeme                      # [REQUIRED] Grafana admin password
LOGGER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Hugging Face Token
#   Used by: Infinity (model download), Unstructured API, dataset generation
#   Get token from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # [REQUIRED] HF read token


# -----------------------------------------------------------------------------
# Infinity Inference Server (prefix: INFINITY_)
#   Source: app/kb/config.py → KBInfinitySettings
#           app/chat/config.py → ChatConfig (infinity_url, prompt_guard_model, nli_model)
#   Used by: docker-compose.yaml (infinity service)
#   Provides: BGE-M3 embeddings, BGE-reranker-v2-m3, Llama-PG-2-86M, indo-roberta NLI
# -----------------------------------------------------------------------------
INFINITY_PORT=7997
INFINITY_BASE_URL=http://127.0.0.1:7997
INFINITY_EMBEDDING_MODEL=BAAI/bge-m3
INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INFINITY_RERANKER_ENABLED=true                # [OPTIONAL] Toggle reranking (default: true)
INFINITY_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
INFINITY_NLI_MODEL=StevenLimcorn/indo-roberta-indonli
INFINITY_HF_API_KEY=${HF_TOKEN}


# -----------------------------------------------------------------------------
# RAM (Response Assessment Module)
#   Used in .env to alias the NLI model
# -----------------------------------------------------------------------------
RAM_NLI_MODEL=${INFINITY_NLI_MODEL}


# -----------------------------------------------------------------------------
# Unstructured API — PDF Parser (prefix: UNSTRUCTURED_)
#   Source: app/kb/config.py → UnstructuredSettings
#   Used by: docker-compose.yaml (unstructured-api service)
# -----------------------------------------------------------------------------
UNSTRUCTURED_PORT=8001
UNSTRUCTURED_BASE_URL=http://127.0.0.1:8001
UNSTRUCTURED_HF_TOKEN=${HF_TOKEN}


# -----------------------------------------------------------------------------
# Qdrant Vector Database (prefix: QDRANT_)
#   Source: app/kb/config.py → QdrantSettings
#   Used by: docker-compose.yaml (qdrant service)
# -----------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=knowledge_base


# -----------------------------------------------------------------------------
# File Storage (prefix: STORAGE_KB_)
#   Source: app/kb/config.py → KBStorageSettings
# -----------------------------------------------------------------------------
STORAGE_KB_UPLOAD_DIR=./uploads/knowledge_base
STORAGE_USER_UPLOAD_DIR=./uploads/user_chat


# -----------------------------------------------------------------------------
# Chat Module — LLM & IVM/RAM Settings (prefix: CHAT_)
#   Source: app/chat/config.py → ChatConfig
#
#   The LLM is OpenAI-compatible. Use OpenRouter, Ollama, or any compatible API.
# -----------------------------------------------------------------------------
# --- Option A: OpenRouter (cloud, recommended for thesis) ---
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # [REQUIRED] OpenRouter API key
CHAT_LLM_MODEL=google/gemini-2.5-flash

# --- Option B: Ollama (local, for development) ---
# CHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_LLM_API_KEY=dummy
# CHAT_LLM_MODEL=qwen2.5:0.5b

CHAT_SYSTEM_PROMPT="You are a helpful AI assistant answering questions based on provided knowledge base context."

# IVM thresholds
CHAT_SECURITY_THRESHOLD=0.75                  # Prompt injection detection threshold
CHAT_SIMILARITY_THRESHOLD=0.4                 # KB search relevance threshold


# -----------------------------------------------------------------------------
# Dataset Generation Pipeline (prefix: DATAGEN_)
#   Source: app/thesis/_eval/_dataset_gen/config.py → DatasetGenSettings
#   Used by: build_subset_{a,b,c,d}.py scripts
#
#   Skripsi §3.2.1c:
#     - Generator: DeepSeek V4 (deterministic, temp=0.0)
#     - Panel: 5 models, majority vote ≥4/5 to accept
# -----------------------------------------------------------------------------
DATAGEN_OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}  # Reuse the same OpenRouter key
DATAGEN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DATAGEN_GENERATOR_MODEL=deepseek/deepseek-chat
DATAGEN_GENERATOR_TEMPERATURE=0.0
DATAGEN_PANEL_MODELS=google/gemini-3.1-pro,meta-llama/llama-3-70b-instruct,mistralai/mistral-large,deepseek/deepseek-chat,zai-org/glm-5.2
DATAGEN_PANEL_TEMPERATURE=0.0
DATAGEN_ACCEPTANCE_THRESHOLD=4
DATAGEN_OUTPUT_DIR=data
DATAGEN_MAX_SAMPLES=0                          # 0 = no limit; set to N for cost control


# -----------------------------------------------------------------------------
# Evaluation Scripts — LLM Client (direct os.environ, no prefix)
#   Source: app/thesis/_eval/_shared/clients.py → get_llm_client_from_env()
#   Used by: exp1b_relevance/run.py (LLM-as-Judge baseline)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}        # Reuse the same OpenRouter key
EVAL_LLM_MODEL=deepseek/deepseek-chat


# -----------------------------------------------------------------------------
# Additional Python Dependencies (not installed via pip by default)
# -----------------------------------------------------------------------------
# The following packages are needed for specific evaluation experiments:
#
#   bert-score    — Experiment 4 (end-to-end BERTScore metric)
#     Install: .venv/bin/pip install bert-score
#     Note: Requires torch (already installed) and transformers (already installed)
#
#   scikit-learn  — Used by bert-score and some metric utilities
#     Install: .venv/bin/pip install scikit-learn
